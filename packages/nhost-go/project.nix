{
  self,
  pkgs,
  nixops-lib,
}:
let
  name = "nhost-go";
  submodule = "packages/${name}";

  fs = pkgs.lib.fileset;

  # codegen is the prebuilt binary; gen.sh prefers it over `go run`.
  codegen = self.packages.${pkgs.system}.codegen;

  tags = [ ];
  ldflags = [ ];
  buildInputs = [ ];
  nativeBuildInputs = [ ];

  checkDeps = [
    codegen
    # Provides a CA bundle (its setup hook sets SSL_CERT_FILE) so the HTTP
    # client can verify the local backend's certificate in the integration run.
    pkgs.cacert
  ];

  # The SDK is its own Go module (github.com/nhost/nhost/packages/nhost-go) with
  # no dependencies, so it builds from this directory alone: no go.sum, no
  # vendor/. The shared check resolves `./${submodule}/...` against `src`, so
  # `src` is the module root, with the repository's lint and govulncheck
  # configuration copied in beside it.
  moduleSrc = fs.toSource {
    root = ./.;
    fileset = fs.unions [
      ./go.mod
      (fs.fileFilter (f: f.hasExt "go") ./.)
    ];
  };

  src = pkgs.runCommand "${name}-src" { } ''
    cp -r ${moduleSrc} $out
    chmod +w $out
    cp ${../../.golangci.yaml} $out/.golangci.yaml
    cp ${../../govulncheck.yaml} $out/govulncheck.yaml
  '';

  # Rooted at the repo for the checks that look outside the module: gen.sh
  # resolves the shared OpenAPI specs via REPO_ROOT (../..), and the SDK's Go
  # version is compared with the root module's.
  repoSrc = fs.toSource {
    root = ../..;
    fileset = fs.unions [
      ../../go.mod
      ./go.mod
      ./gen.sh
      (fs.fileFilter (f: f.hasExt "go") ./.)
      ../../services/auth/docs/openapi.yaml
      ../../services/storage/controller/openapi.yaml
    ];
  };
in
{
  devShell = nixops-lib.go.devShell {
    buildInputs = checkDeps ++ [
      pkgs.nhost.nhost-cli
    ];
  };

  # The shared check runs golines/gofumpt, govulncheck and golangci-lint, and
  # already sets __noChroot, which the integration run needs to reach the local
  # backend started by `make dev-env-up`.
  check = nixops-lib.go.check {
    inherit
      src
      ldflags
      tags
      buildInputs
      nativeBuildInputs
      checkDeps
      ;

    submodule = ".";

    # The clients are generated by gen.sh rather than `go generate`, so the
    # shared sha1sum check does not cover them. Regenerate into a scratch copy
    # and diff against what is committed.
    preCheck = ''
      echo "➜ Checking the generated clients are up to date..."
      mkdir -p $TMPDIR/gen
      cp -r ${repoSrc}/* $TMPDIR/gen
      chmod +w -R $TMPDIR/gen
      sh $TMPDIR/gen/${submodule}/gen.sh
      diff ${repoSrc}/${submodule}/auth/client.go $TMPDIR/gen/${submodule}/auth/client.go \
        || (echo "❌ auth/client.go is stale; run ./gen.sh" && exit 1)
      diff ${repoSrc}/${submodule}/storage/client.go $TMPDIR/gen/${submodule}/storage/client.go \
        || (echo "❌ storage/client.go is stale; run ./gen.sh" && exit 1)
      echo ""

      echo "➜ Checking the SDK targets the repository's Go version..."
      source_go=$(sed -n 's/^go //p' ${repoSrc}/${submodule}/go.mod)
      root_go=$(sed -n 's/^go //p' ${repoSrc}/go.mod)
      if [ "$source_go" != "$root_go" ]; then
        echo "❌ the SDK's go.mod says go $source_go but the root go.mod says go $root_go; bump them together"
        exit 1
      fi
      echo ""
    '';

    # The integration suite is build-tagged, so the shared test run skips it.
    extraCheck = ''
      echo "➜ Linting the integration-tagged sources..."
      cd ${src}
      golangci-lint run \
        --timeout 600s \
        --build-tags integration \
        ./...

      echo "➜ Running the integration suite against the local backend..."
      export NHOST_LOCAL_BACKEND=1
      richgo test \
        -tags integration \
        -run TestIntegration \
        -v \
        ./...
    '';
  };

  package =
    pkgs.runCommand "nhost-go"
      {
        nativeBuildInputs = [ pkgs.nhost.go ];
      }
      ''
        export HOME=$(mktemp -d)
        export GOCACHE="$HOME/gocache"
        # The module has no dependencies, so nothing is ever fetched.
        export GOPROXY=off
        export CGO_ENABLED=0
        cp -r ${moduleSrc} src
        chmod +w -R src
        cd src
        go build ./...
        mkdir $out
      '';
}
