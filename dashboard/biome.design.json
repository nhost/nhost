{
  "root": true,
  "extends": ["../biome.json", "./biome.json"],
  "vcs": {
    "root": ".."
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noImportCycles": "off"
      }
    }
  },
  "plugins": [
    {
      "path": "./design-doctor/generated/plugins/no-direct-radix-imports.grit",
      "includes": [
        "**/dashboard/src/**",
        "!**/dashboard/src/components/ui/v3/**",
        "!**/dashboard/src/**/*.test.*",
        "!**/dashboard/src/**/*.spec.*",
        "!**/dashboard/src/**/__tests__/**",
        "!**/dashboard/src/**/tests/**",
        "!**/dashboard/src/**/testUtils/**",
        "!**/dashboard/src/**/mocks/**",
        "!**/dashboard/src/**/__mocks__/**",
        "!**/dashboard/src/**/generated/**",
        "!**/dashboard/src/**/__generated__/**"
      ]
    },
    {
      "path": "./design-doctor/generated/plugins/no-reinvented-components.grit",
