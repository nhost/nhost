import { execFileSync } from 'node:child_process';
import { mkdir, readdir, readFile, rm, writeFile } from 'node:fs/promises';
import { join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { catalogMeta } from '../../catalog.meta.mts';
import { buildCatalog } from '../catalog/build.mts';
import { catalogSchema } from '../contracts/catalog.mts';
import { indexSchema } from '../contracts/index.mts';
import { tokensSchema } from '../contracts/tokens.mts';
import { designConfig, ruleArtifacts } from '../grit/emit.mts';
import { loadManifest } from '../grit/manifest.mts';
import { loadTheme } from '../theme/load.mts';
import { buildTokens } from './build.mts';
import { inputHashes } from './inputs.mts';

const doctor = fileURLToPath(new URL('../..', import.meta.url));
const dashboard = resolve(doctor, '..');
export async function generate(
  check: boolean,
  root = dashboard,
  output = join(doctor, 'generated'),
  configPath = join(root, 'biome.design.json'),
): Promise<string[]> {
  const { declaredColors, resolved } = loadTheme(root);
  const css = await readFile(join(root, 'src/styles/globals.css'), 'utf8');
  const tokens = tokensSchema.parse(
    buildTokens(declaredColors, resolved.theme as Record<string, unknown>, css),
  );
  const json = `${JSON.stringify(tokens, null, 2)}\n`;
  const rows = Object.entries(tokens.colors).map(
    ([name, color]) =>
      `| \`${name}\` | \`${color.expression}\` | ${color.light ?? '—'} | ${color.dark ?? '—'} | ${color.themeAware} | ${color.valid} |`,
  );
  const markdown = `# Dashboard design tokens\n\nGenerated by \`pnpm design-doctor generate\`. Do not edit. Colors are from \`theme.extend.colors\` only. \`—\` means the color cannot be resolved in that theme (e.g. a variable is undefined there). Tokens resolved in only one theme are usable with the matching variant (e.g. \`dark:\`); only declarations that resolve in neither theme are invalid. Resolved colors use CSS variables from \`globals.css\`. Lengths assume 1rem = 16px; unresolved expressions have null px.\n\n| Token | Declaration | Light | Dark | Theme-aware | Valid |\n| --- | --- | --- | --- | --- | --- |\n${rows.join('\n')}\n\n## Scales\n\n${Object.entries(
    tokens.scales,
  )
    .map(
      ([name, values]) =>
        `### ${name}\n\n${Object.entries(values)
          .map(
            ([step, value]) =>
              `- \`${step}\`: \`${value.value}\` (${value.px === null ? 'unresolved' : `${value.px}px`})`,
          )
          .join('\n')}`,
    )
    .join('\n\n')}\n`;
  const catalogFiles = new Set<string>();
  const catalog = catalogSchema.parse(
    await buildCatalog(root, catalogMeta, catalogFiles),
  );
  const catalogJson = `${JSON.stringify(catalog, null, 2)}\n`;
  const cell = (value: string) =>
    value.replaceAll('|', '\\|').replaceAll('\n', ' ');
  const catalogRows = catalog.components.map(
    (component) =>
      `| \`${component.name}\` | \`${component.importPath}\` | ${cell(component.purpose ?? 'Undocumented')} | ${component.replaces.map((tag) => `\`${tag}\``).join(', ') || '—'} | ${component.dropIn} | ${
        component.cva
          .map(
            (recipe) =>
              `\`${recipe.name}\`: ${Object.entries(recipe.variants)
                .map(([name, values]) => `${name} (${values.join(', ')})`)
                .join('; ')}; defaults ${Object.entries(recipe.defaultVariants)
                .map(([name, value]) => `${name}=${value}`)
                .join(', ')}${Object.entries(recipe.conditionalDefaults)
                .map(
                  ([condition, values]) =>
                    `; ${condition} ${Object.entries(values)
                      .map(([name, value]) => `${name}=${value}`)
                      .join(', ')}`,
                )
                .join('')}`,
          )
          .join('<br>') || '—'
      } | ${component.radix ? `\`${component.radix.package}\` → \`${component.radix.primitive}\`` : '—'} |`,
  );
  const catalogMarkdown = `# Dashboard component catalog\n\nGenerated by \`pnpm design-doctor generate\`. Do not edit. A replacement is not necessarily a drop-in substitution; check props, markup and behavior before migrating. CVA variants and defaults list recipes declared in the component's own module only; imported recipes (e.g. \`toggleVariants\` in \`ToggleGroupItem\`, \`buttonVariants\` in \`AlertDialogAction\` and \`PaginationLink\`) are not listed. \`InputGroupButton\` lists its local size recipe but not Button's imported variant recipe. Check the source for those props.\n\n| Export | Import path | Purpose | Replaces | Drop-in | CVA variants and defaults | Wrapped Radix primitive |\n| --- | --- | --- | --- | --- | --- | --- |\n${catalogRows.join('\n')}\n\n## Undocumented components\n\n${catalog.undocumented.map((id) => `- \`${id}\``).join('\n') || 'None'}\n`;
  const manifest = await loadManifest();
  const ruleFiles = ruleArtifacts(manifest, catalog, tokens, resolved);
  const artifacts = [
    'catalog.json',
    'catalog.md',
    'index.json',
    ...Object.keys(ruleFiles),
    'tokens.json',
    'tokens.md',
  ].sort();
  const index = indexSchema.parse({
    schemaVersion: 1,
    artifacts,
    inputs: await inputHashes(root, catalogFiles),
  });
  const contents = new Map([
    ['catalog.json', catalogJson],
    ['catalog.md', catalogMarkdown],
    ['tokens.json', json],
    ['tokens.md', markdown],
    ['index.json', `${JSON.stringify(index, null, 2)}\n`],
    ...Object.entries(ruleFiles),
  ]);
  // Config is outside generated/, but is an artifact of the same manifest.
  const config = execFileSync(
    'biome',
    ['format', '--stdin-file-path=biome.design.json'],
    { cwd: root, input: designConfig(manifest), encoding: 'utf8' },
  );
  async function list(
    dir: string,
    prefix = '',
  ): Promise<{
    files: string[];
    directories: string[];
  }> {
    try {
      const entries = await readdir(dir, { withFileTypes: true });
      const children = await Promise.all(
        entries.map(async (entry) => {
          const path = prefix ? `${prefix}/${entry.name}` : entry.name;
          if (entry.isDirectory()) {
            const nested = await list(join(dir, entry.name), path);
            return {
              files: nested.files,
              directories: [path, ...nested.directories],
            };
          }
          return { files: [path], directories: [] };
        }),
      );
      return {
        files: children.flatMap((child) => child.files),
        directories: children.flatMap((child) => child.directories),
      };
    } catch (error) {
      if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
        return { files: [], directories: [] };
      }
      throw error;
    }
  }
  const existing = await list(output);
  const orphanDirectories = existing.directories.filter(
    (dir) => ![...contents.keys()].some((path) => path.startsWith(`${dir}/`)),
  );
  const drift: string[] = [
    ...existing.files.filter(
      (path) =>
        !contents.has(path) &&
        !orphanDirectories.some((dir) => path.startsWith(`${dir}/`)),
    ),
    ...orphanDirectories.filter(
      (dir) =>
        !orphanDirectories.some((parent) => dir.startsWith(`${parent}/`)),
    ),
  ];
  let priorConfig: string | null = null;
  try {
    priorConfig = await readFile(configPath, 'utf8');
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') {
      throw error;
    }
  }
  if (priorConfig !== config) {
    drift.push('biome.design.json');
  }
  for (const [path, content] of contents) {
    const dest = join(output, path);
    let old: string | null = null;
    try {
      old = await readFile(dest, 'utf8');
    } catch (error) {
      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') {
        throw error;
      }
    }
    if (old !== content) {
      drift.push(path);
    }
  }
  if (!check) {
    await mkdir(output, { recursive: true });
    for (const path of orphanDirectories.filter(
      (dir) =>
        !orphanDirectories.some((parent) => dir.startsWith(`${parent}/`)),
    )) {
      await rm(join(output, path), { recursive: true });
    }
    for (const path of existing.files.filter(
      (name) =>
        !contents.has(name) &&
        !orphanDirectories.some((dir) => name.startsWith(`${dir}/`)),
    )) {
      await rm(join(output, path));
    }
    for (const [path, content] of contents) {
      await mkdir(join(output, path, '..'), { recursive: true });
      await writeFile(join(output, path), content);
    }
    await writeFile(configPath, config);
    return [];
  }
  return drift.sort();
}
