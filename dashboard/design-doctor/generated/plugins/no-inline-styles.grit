language js

pattern style_object() { or {
  JsObjectExpression(),
  TsAsExpression(expression=$inner) where { $inner <: style_object() },
  TsSatisfiesExpression(expression=$inner) where { $inner <: style_object() },
  JsParenthesizedExpression(expression=$inner) where { $inner <: style_object() }
} }
pattern allowed_style() { or {
  JsIdentifierExpression() as $leaf where { $leaf <: r"^(?:floatingStyles|provided\.draggableProps\.style|style|props\.style)$" },
  JsStaticMemberExpression() as $leaf where { $leaf <: r"^(?:floatingStyles|provided\.draggableProps\.style|style|props\.style)$" },
  TsAsExpression(expression=$inner) where { $inner <: allowed_style() },
  TsSatisfiesExpression(expression=$inner) where { $inner <: allowed_style() },
  JsParenthesizedExpression(expression=$inner) where { $inner <: allowed_style() }
} }
pattern literal_color() { or {
  r"(?i)[\s\S]*#[0-9a-f]{3,8}(?:[^0-9a-f]|$)[\s\S]*",
  r"(?i)[\s\S]*(?:rgb|rgba|hsl|hsla|hwb|oklch|oklab|lab|lch|color|color-mix|light-dark)\([a-z0-9.% ,/+\-]+\)[\s\S]*",
  r"(?i)[\s\S]*(?:^|[^a-z-])(?:aliceblue|antiquewhite|aqua|aquamarine|azure|beige|bisque|black|blanchedalmond|blue|blueviolet|brown|burlywood|cadetblue|chartreuse|chocolate|coral|cornflowerblue|cornsilk|crimson|cyan|darkblue|darkcyan|darkgoldenrod|darkgray|darkgreen|darkgrey|darkkhaki|darkmagenta|darkolivegreen|darkorange|darkorchid|darkred|darksalmon|darkseagreen|darkslateblue|darkslategray|darkslategrey|darkturquoise|darkviolet|deeppink|deepskyblue|dimgray|dimgrey|dodgerblue|firebrick|floralwhite|forestgreen|fuchsia|gainsboro|ghostwhite|gold|goldenrod|gray|green|greenyellow|grey|honeydew|hotpink|indianred|indigo|ivory|khaki|lavender|lavenderblush|lawngreen|lemonchiffon|lightblue|lightcoral|lightcyan|lightgoldenrodyellow|lightgray|lightgreen|lightgrey|lightpink|lightsalmon|lightseagreen|lightskyblue|lightslategray|lightslategrey|lightsteelblue|lightyellow|lime|limegreen|linen|magenta|maroon|mediumaquamarine|mediumblue|mediumorchid|mediumpurple|mediumseagreen|mediumslateblue|mediumspringgreen|mediumturquoise|mediumvioletred|midnightblue|mintcream|mistyrose|moccasin|navajowhite|navy|oldlace|olive|olivedrab|orange|orangered|orchid|palegoldenrod|palegreen|paleturquoise|palevioletred|papayawhip|peachpuff|peru|pink|plum|powderblue|purple|rebeccapurple|red|rosybrown|royalblue|saddlebrown|salmon|sandybrown|seagreen|seashell|sienna|silver|skyblue|slateblue|slategray|slategrey|snow|springgreen|steelblue|tan|teal|thistle|tomato|turquoise|violet|wheat|white|whitesmoke|yellow|yellowgreen)(?:[^a-z-]|$)[\s\S]*"
} }

or {
  JsPropertyObjectMember(name=$name, value=$value) as $member where {
    $member <: within JsObjectExpression(members=$members) as $obj,
    $members <: some $member,
    $obj <: within JsxExpressionAttributeValue(expression=$expr),
    $expr <: or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }) }) },
    $member <: within JsxAttribute(name="style"),
    or {
      $name <: r"^['\x22](--[^'\x22]+)['\x22]$"($custom) where {
        not { $value <: JsCallExpression() },
        $value <: contains or { JsStringLiteralExpression() as $leaf, JsTemplateChunkElement() as $leaf } where { $leaf <: literal_color() },
        register_diagnostic(span=$member, message=`[design/no-inline-styles] "$custom" Literal color in a custom property bypasses the theme. Use a declared color from design-doctor/generated/tokens.md instead of injecting a raw color. Docs: design-doctor/docs/rules/no-inline-styles.md`, severity="warn")
      },
      $name <: r"^[\s\S]+$" where {
        not { $name <: r"^['\x22]--[^'\x22]+['\x22]$" },
        not { $name <: JsComputedMemberName() },
        or {
          $name <: r"^['\x22]([^'\x22]+)['\x22]$"($label),
          $label = join(split(join(split(join(split(join(split(join(split(join(split($name, "\n"), ""), "	"), ""), " "), ""), ",}"), "}"), ",]"), "]"), ",)"), ")")
        },
        register_diagnostic(span=$member, message=`[design/no-inline-styles] "$label" Inline property bypasses design tokens. Use a Tailwind v3 class; for dynamic values use style={{ '--x': value }} with w-[var(--x)]. Colors are defined in design-doctor/generated/tokens.md. Docs: design-doctor/docs/rules/no-inline-styles.md`, severity="warn")
      },
      $name <: JsComputedMemberName() where {
        register_diagnostic(span=$member, message=`[design/no-inline-styles] "[computed]" Unreadable style cannot be checked for tokens. Use classes, or style={{ '--x': value }} with w-[var(--x)] for dynamic values; see design-doctor/generated/tokens.md. Docs: design-doctor/docs/rules/no-inline-styles.md`, severity="warn")
      }
    }
  },
  JsShorthandPropertyObjectMember(name=$name) as $member where {
    $member <: within JsObjectExpression(members=$members) as $obj,
    $members <: some $member,
    $obj <: within JsxExpressionAttributeValue(expression=$expr),
    $expr <: or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }) }) },
    $member <: within JsxAttribute(name="style"),
    $label = join(split(join(split(join(split(join(split(join(split(join(split($name, "\n"), ""), "	"), ""), " "), ""), ",}"), "}"), ",]"), "]"), ",)"), ")"),
    register_diagnostic(span=$member, message=`[design/no-inline-styles] "$label" Inline property bypasses design tokens. Use a Tailwind v3 class; for dynamic values use style={{ '--x': value }} with w-[var(--x)]. Colors are defined in design-doctor/generated/tokens.md. Docs: design-doctor/docs/rules/no-inline-styles.md`, severity="warn")
  },
  JsSpread(argument=$arg) as $member where {
    $member <: within JsObjectExpression(members=$members) as $obj,
    $members <: some $member,
    $obj <: within JsxExpressionAttributeValue(expression=$expr),
    $expr <: or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), TsSatisfiesExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }), JsParenthesizedExpression(expression=or { $obj, TsAsExpression(expression=$obj), TsSatisfiesExpression(expression=$obj), JsParenthesizedExpression(expression=$obj) }) }) },
    $member <: within JsxAttribute(name="style"),
    not { $arg <: r"^(?:floatingStyles|provided\.draggableProps\.style|style|props\.style)$" },
    $label = join(split(join(split(join(split(join(split(join(split(join(split($arg, "\n"), ""), "	"), ""), " "), ""), ",}"), "}"), ",]"), "]"), ",)"), ")"),
    register_diagnostic(span=$member, message=`[design/no-inline-styles] "...$label" Unreadable style cannot be checked for tokens. Use classes, or style={{ '--x': value }} with w-[var(--x)] for dynamic values; see design-doctor/generated/tokens.md. Docs: design-doctor/docs/rules/no-inline-styles.md`, severity="warn")
  },
  JsxAttribute(name="style", initializer=$init) as $attr where {
    or {
      $init <: contains JsxString() where {
        register_diagnostic(span=$attr, message=`[design/no-inline-styles] "style" Unreadable style cannot be checked for tokens. Use classes, or style={{ '--x': value }} with w-[var(--x)] for dynamic values; see design-doctor/generated/tokens.md. Docs: design-doctor/docs/rules/no-inline-styles.md`, severity="warn")
      },
      $init <: contains JsxExpressionAttributeValue(expression=$expr) where {
        not { $expr <: style_object() },
        not { $expr <: allowed_style() },
        not { $expr <: r"^(?:null|undefined)$" },
        or {
          $expr <: JsCallExpression(callee=$callee) where {
            $label = join(split(join(split(join(split(join(split(join(split(join(split($callee, "\n"), ""), "	"), ""), " "), ""), ",}"), "}"), ",]"), "]"), ",)"), ")"),
            register_diagnostic(span=$attr, message=`[design/no-inline-styles] "$label()" Unreadable style cannot be checked for tokens. Use classes, or style={{ '--x': value }} with w-[var(--x)] for dynamic values; see design-doctor/generated/tokens.md. Docs: design-doctor/docs/rules/no-inline-styles.md`, severity="warn")
          },
          $expr <: r"[\s\S]+" where {
            $label = join(split(join(split(join(split(join(split(join(split(join(split($expr, "\n"), ""), "	"), ""), " "), ""), ",}"), "}"), ",]"), "]"), ",)"), ")"),
            register_diagnostic(span=$attr, message=`[design/no-inline-styles] "$label" Unreadable style cannot be checked for tokens. Use classes, or style={{ '--x': value }} with w-[var(--x)] for dynamic values; see design-doctor/generated/tokens.md. Docs: design-doctor/docs/rules/no-inline-styles.md`, severity="warn")
          }
        }
      }
    }
  },
  JsxOpeningElement(name="style") as $node where {
    register_diagnostic(span=$node, message=`[design/no-inline-styles] "<style>" Style elements inject CSS outside the design system. Use classes or declare shared rules in src/styles/globals.css. Docs: design-doctor/docs/rules/no-inline-styles.md`, severity="warn")
  },
  JsxSelfClosingElement(name="style") as $node where {
    register_diagnostic(span=$node, message=`[design/no-inline-styles] "<style>" Style elements inject CSS outside the design system. Use classes or declare shared rules in src/styles/globals.css. Docs: design-doctor/docs/rules/no-inline-styles.md`, severity="warn")
  }
}
