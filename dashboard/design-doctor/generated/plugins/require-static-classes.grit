language js

or {
  JsTemplateChunkElement() as $site where {
    $site <: within or { JsxAttribute(name=r"^(?:className|[A-Za-z_$][A-Za-z0-9_$]*ClassName)$"), JsCallExpression(callee=r"^(?:cn|clsx|cx|twMerge|twJoin|tw|cva)$") },
    not { $site <: within or { JsBinaryExpression(), JsComputedMemberName(), JsComputedMemberExpression() } },
    not { $site <: within JsCallExpression(callee=not r"^(?:cn|clsx|cx|twMerge|twJoin|tw|cva)$") until or { JsxAttribute(name=r"^(?:className|[A-Za-z_$][A-Za-z0-9_$]*ClassName)$"), JsCallExpression(callee=r"^(?:cn|clsx|cx|twMerge|twJoin|tw|cva)$") } },
    or {
      $site <: after JsTemplateElement() where {
        $site <: before JsTemplateElement(),
        or {
          $site <: r"^([^\s]+)[\s](?:[\s\S]*[\s])?([^\s]+)$"($first, $last),
          $site <: r"^([^\s]+)$"($first) where { $last = $first }
        },
        register_diagnostic(span=$site, message=`[design/require-static-classes] ${…}$first $last${…}  Guidance: Glued interpolation may not generate CSS in Tailwind v3 and cannot be checked by the other design rules. Use a lookup of complete classes, a conditional, or a CSS variable with w-[var(--x)]. Docs: design-doctor/docs/rules/require-static-classes.md`, severity="warn")
      },
      $site <: r"^(?:[\s\S]*[\s])?([^\s]+)$"($last) where {
        $site <: before JsTemplateElement(),
        or {
          and {
            $site <: within JsTemplateExpression() as $template,
            $template <: r"^\x60(?:[^$\x60]*\$\{[^$\x60]*\})*([^$\x60]*)\$\{[^$\x60]*\}([^$\x60]*)\x60$"($before, $after),
            $site <: $before,
            $before <: r"^(?:[\s\S]*[\s])?[^\s]+$",
            $after <: r"^([^\s]*)(?:[\s][\s\S]*)?$"($tail),
            register_diagnostic(span=$site, message=`[design/require-static-classes] "$last${…}$tail" Glued interpolation may not generate CSS in Tailwind v3 and cannot be checked by the other design rules. Use a lookup of complete classes, a conditional, or a CSS variable with w-[var(--x)]. Docs: design-doctor/docs/rules/require-static-classes.md`, severity="warn")
          },
          register_diagnostic(span=$site, message=`[design/require-static-classes] "$last${…}" Glued interpolation may not generate CSS in Tailwind v3 and cannot be checked by the other design rules. Use a lookup of complete classes, a conditional, or a CSS variable with w-[var(--x)]. Docs: design-doctor/docs/rules/require-static-classes.md`, severity="warn")
        }
      },
      $site <: r"^([^\s]+)(?:[\s][\s\S]*)?$"($first) where {
        $site <: after JsTemplateElement(),
        not {
          $site <: within JsTemplateExpression() as $template,
          $template <: r"^\x60(?:[^$\x60]*\$\{[^$\x60]*\})*([^$\x60]*)\$\{[^$\x60]*\}([^$\x60]*)\x60$"($before, $after),
          $before <: r"^(?:[\s\S]*[\s])?[^\s]+$",
          or { $template <: r"^\x60[^$\x60]*\$\{[^$\x60]*\}[^$\x60]*\x60$", $before <: r"^\s[\s\S]*$" }
        },
        register_diagnostic(span=$site, message=`[design/require-static-classes] "${…}$first" Glued interpolation may not generate CSS in Tailwind v3 and cannot be checked by the other design rules. Use a lookup of complete classes, a conditional, or a CSS variable with w-[var(--x)]. Docs: design-doctor/docs/rules/require-static-classes.md`, severity="warn")
      }
    }
  },
  JsxAttribute(name=r"^(?:className|[A-Za-z_$][A-Za-z0-9_$]*ClassName)$", initializer=$value) as $attr where {
    $value <: contains JsxExpressionAttributeValue(expression=$e),
    or {
      $e <: JsIdentifierExpression() as $kind,
      $e <: JsStaticMemberExpression() as $kind,
      $e <: JsCallExpression(callee=not r"^(?:cn|clsx|cx|twMerge|twJoin|tw)$") as $kind,
      $e <: JsLogicalExpression(right=$kind) where { $kind <: or {
    JsIdentifierExpression(),
    JsStaticMemberExpression(),
    JsCallExpression(callee=not r"^(?:cn|clsx|cx|twMerge|twJoin|tw)$")
  } },
      $e <: JsConditionalExpression(consequent=$kind, alternate=$second) where {
        or { $kind <: or {
    JsIdentifierExpression(),
    JsStaticMemberExpression(),
    JsCallExpression(callee=not r"^(?:cn|clsx|cx|twMerge|twJoin|tw)$")
  }, $second <: or {
    JsIdentifierExpression(),
    JsStaticMemberExpression(),
    JsCallExpression(callee=not r"^(?:cn|clsx|cx|twMerge|twJoin|tw)$")
  } }
      }
    },
    $attr <: within JsModule() as $module,
    $attr <: within or { JsxOpeningElement(name=$name), JsxSelfClosingElement(name=$name) },
    or {
    and {
      $name <: r"^([A-Za-z_$][A-Za-z0-9_$]*)$"($local),
      $module <: contains or {
        JsNamedImportSpecifier(name=$original, local_name=$local) as $spec,
        JsShorthandNamedImportSpecifier(local_name=$local) as $spec,
        JsDefaultImportSpecifier(local_name=$local) as $spec
      } where {
        $spec <: within or { JsImportNamedClause(source=$source), JsImportCombinedClause(source=$source), JsImportDefaultClause(source=$source) },
        $source <: includes "@/components/",
        $source <: r"^['\x22](?:@\/components\/common\/ApplyLocalSettingsDialog|@\/components\/common\/CookieConsent|@\/components\/common\/DatePicker|@\/components\/common\/DateTimePicker|@\/components\/common\/DialogProvider|@\/components\/common\/DiscardChangesDialog|@\/components\/common\/DragAndDropList|@\/components\/common\/ElevateSessionDialog|@\/components\/common\/MfaOtpForm|@\/components\/common\/NavLink|@\/components\/common\/OpenTransferDialogButton|@\/components\/common\/Pagination|@\/components\/common\/PermissionSettingsSection|@\/components\/common\/PermissionsGrid|@\/components\/common\/PermissionsGridLayout|@\/components\/common\/PickerTriggerSlot|@\/components\/common\/RoleActionSwitcher|@\/components\/common\/SelectOrg|@\/components\/common\/SelectOrgAndProject|@\/components\/common\/ThemeSwitcher|@\/components\/common\/TimePicker|@\/components\/common\/TimePickerField|@\/components\/common\/TimezonePicker|@\/components\/common\/UpgradeToProBanner|@\/components\/common\/VirtualizedCombobox|@\/components\/common\/useMediaQuery|@\/components\/form\/Form|@\/components\/form\/FormActivityIndicator|@\/components\/form\/FormCheckbox|@\/components\/form\/FormCodeEditor|@\/components\/form\/FormCombobox|@\/components\/form\/FormFreeCombobox|@\/components\/form\/FormInput|@\/components\/form\/FormPasswordInput|@\/components\/form\/FormSelect|@\/components\/form\/FormSwitch|@\/components\/form\/FormTextarea|@\/components\/presentational\/CodeBlock|@\/components\/presentational\/CopyToClipboardButton|@\/components\/presentational\/ErrorMessage|@\/components\/presentational\/HighlightedText|@\/components\/presentational\/HoverCardTimestamp|@\/components\/presentational\/LoadingScreen|@\/components\/presentational\/Logo|@\/components\/presentational\/Nav|@\/components\/presentational\/NhostIcon|@\/components\/presentational\/ReadOnlyCombobox|@\/components\/presentational\/ReadOnlySelect|@\/components\/presentational\/ReadOnlyToggle|@\/components\/presentatio