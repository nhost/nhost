language js

or {
  or {
    JsNamedImportSpecifier(name=$name) as $spec,
    JsShorthandNamedImportSpecifier(local_name=$name) as $spec,
    JsExportNamedFromSpecifier(source_name=$name) as $spec
  } where {
    $spec <: within or { JsImportNamedClause(source=$source), JsImportCombinedClause(source=$source), JsExportFromClause(source=$source), JsExportNamedFromClause(source=$source) },
    $source <: r"^['\x22]@radix-ui/[a-z0-9-]+['\x22]$",
    not { $source <: r"^['\x22]@radix-ui/react-slot['\x22]$" },
    $name <: r"^[A-Za-z_$][A-Za-z0-9_$]*$",
    or { $source <: r"^['\x22]@radix-ui/react-accordion['\x22]$" where { or { $name <: r"^(?:Accordion|Root)$" where { register_diagnostic(span=$name, message=`[design/no-direct-radix-imports] "$name" Use Accordion from @/components/ui/v3/accordion; check props and behavior, not a guaranteed drop-in replacement. Docs: design-doctor/docs/rules/no-direct-radix-imports.md`, severity="warn") },
