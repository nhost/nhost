        $name <: r"^(?:AccordionTrigger|Trigger)$" where { register_diagnostic(span=$name, message=`[design/no-direct-radix-imports] "$name" Use AccordionTrigger from @/components/ui/v3/accordion; check props and behavior, not a guaranteed drop-in replacement. Docs: design-doctor/docs/rules/no-direct-radix-imports.md`, severity="warn") },
        $name <: r".*" where { not { $name <: r"^(?:Accordion|AccordionContent|AccordionItem|AccordionTrigger|Content|Item|Root|Trigger)$" }, register_diagnostic(span=$name, message=`[design/no-direct-radix-imports] "$name" No exact ui/v3 export is recorded for this primitive; check the catalog or ask design before replacing it. Docs: design-doctor/docs/rules/no-direct-radix-imports.md`, severity="warn") } } },
      $source <: r"^['\x22]@radix-ui/react-alert-dialog['\x22]$" where { or { $name <: r"^(?:Action|AlertDialogAction)$" where { register_diagnostic(span=$name, message=`[design/no-direct-radix-imports] "$name" Use AlertDialogAction from @/components/ui/v3/alert-dialog; check props and behavior, not a guaranteed drop-in replacement. Docs: design-doctor/docs/rules/no-direct-radix-imports.md`, severity="warn") },
