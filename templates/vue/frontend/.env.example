# Backend coordinates for the client this app creates.
#
# Vite inlines VITE_* at build time: set these before `vite build`. Setting
# them on the running host has no effect, and a build that leaves them unset
# permanently targets the local stack.
#
# This is a browser app, so everything here ships to the visitor. Never put a
# secret in a VITE_* variable.
VITE_NHOST_SUBDOMAIN=local
VITE_NHOST_REGION=local

# Where this app is deployed. Auth emails point back here, so it is configured
# rather than read from `window.location`: a copy of this app served from
# somewhere else would otherwise ask the backend to send sign-in links there.
# Set it to the real origin before `vite build`, and keep it in the backend's
# `auth.redirections.allowedUrls`.
VITE_APP_ORIGIN=http://localhost:3000
