{
  "name": "vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check src vite.config.ts codegen.ts",
    "format": "biome format --write src vite.config.ts codegen.ts",
    "typecheck": "vue-tsc --noEmit",
    "codegen:schema": "nhost schema dump --subdomain local --role user -o schema.graphql",
    "codegen:types": "graphql-codegen --config codegen.ts",
    "codegen": "pnpm codegen:schema && pnpm codegen:types",
    "test": "vitest run"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nhost/nhost-js": "^4.7.2",
    "graphql": "^16.14.2",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.10"
  }
}
