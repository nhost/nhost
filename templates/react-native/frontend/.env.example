# Backend coordinates for the client this app creates.
#
# Expo inlines EXPO_PUBLIC_* at build time: set these before the bundle is
# made. Changing them on a running app has no effect, and a bundle built
# without them permanently targets the local stack.
#
# Everything here ships inside the app on the user's device, which anyone can
# unpack. Never put a secret in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_NHOST_SUBDOMAIN=local
EXPO_PUBLIC_NHOST_REGION=local
