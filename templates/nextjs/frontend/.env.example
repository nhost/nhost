# Backend coordinates for the browser client and for server components. Both
# halves read this one pair, so they can never point at different backends.
#
# Next.js inlines NEXT_PUBLIC_* at build time: set these before `next build`.
# Setting them on the running host has no effect, and a build that leaves them
# unset permanently targets the local stack.
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=local

# Optional: the slug of the organization a cloud project belongs to, the part
# after /orgs/ in the project's dashboard URL. With it the footer links the
# project's dashboard page directly; without it, the dashboard's project
# picker. Ignored for the local stack. Same build-time rule as the pair above.
# NEXT_PUBLIC_NHOST_ORG_SLUG=

# Where this app is deployed. Auth emails point back here, so it is configured
# rather than read from the request: a Host header is set by whoever sent the
# request, which would let anyone aim somebody else's sign-in link at a host
# they control. Set it to the real origin before `next build`, and set the
# backend's APP_ORIGIN secret to the same value. On Vercel it can stay unset:
# the build falls back to the project's production domain.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# The OAuth providers the backend has set up, comma-separated: github, google.
# The frontend cannot read the backend's config, so this is how it knows which
# buttons would work. Unset, it offers none. Read on the server at request
# time, so unlike the variables above it does not need setting before a build.
# NHOST_OAUTH_PROVIDERS=github,google
