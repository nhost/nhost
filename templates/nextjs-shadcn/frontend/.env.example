# Backend coordinates for the browser client and for server components. Both
# halves read this one pair, so they can never point at different backends.
#
# Next.js inlines NEXT_PUBLIC_* at build time: set these before `next build`.
# Setting them on the running host has no effect, and a build that leaves them
# unset permanently targets the local stack.
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=local

# Public origin of this app, used for the links inside password-reset and
# email-change emails. Set it wherever the app is deployed: without it, in
# production, those emails fail to send, rather than building the link from the
# request's Host header, which is whatever the client sent and the last thing a
# reset link should point at. Read on the server at runtime, so it is not a
# NEXT_PUBLIC_ value.
# APP_ORIGIN=https://example.com
