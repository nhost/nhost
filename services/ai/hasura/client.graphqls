fragment GraphiteAutoEmbeddingsConfigurationFragment on graphiteAutoEmbeddingsConfiguration {
    id
    name
    schemaName
    tableName
    columnName
    model
    query
    mutation
    lastRun
}

query GetGraphiteAutoEmbeddingsConfigurations(
    $where: graphiteAutoEmbeddingsConfiguration_bool_exp
) {
    graphiteAutoEmbeddingsConfigurations(where: $where) {
        ...GraphiteAutoEmbeddingsConfigurationFragment
    }
}

query GetGraphiteAutoEmbeddingsConfiguration($id: uuid!) {
    graphiteAutoEmbeddingsConfiguration(id: $id) {
        ...GraphiteAutoEmbeddingsConfigurationFragment
    }
}

query GetAgent($id: uuid!) {
    graphiteAgent(id: $id) {
        id
        name
        description
        instructions
        provider
        model
        toolsConfig
        userID
        createdAt
        updatedAt
    }
}

query GetAgentSession($id: uuid!) {
    graphiteAgentSession(id: $id) {
        id
        agentID
        userID
        createdAt
        updatedAt
    }
}

query GetAgentMessages($where: graphiteAgentMessages_bool_exp) {
    graphiteAgentMessages(where: $where, order_by: {createdAt: asc, seq: asc}) {
        id
        sessionID
        role
        content
        toolCalls
        toolCallID
        toolName
        createdAt
    }
}

mutation InsertAgentMessages($objects: [graphiteAgentMessages_insert_input!]!) {
    insertGraphiteAgentMessages(objects: $objects) {
        returning {
            id
        }
    }
}
