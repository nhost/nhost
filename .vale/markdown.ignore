# Markdown that .vale/lint_markdown.sh skips. One bash glob per line, matched
# against the path from the repository root; `*` crosses directories.
#
# Every entry needs a reason that is not "it has findings". Fix a page, or
# relax the rule in .vale.ini on a measured count, rather than listing it here.

# Linted by their own configs: docs/.vale.ini and landing/.vale.ini.
docs/src/content/docs/*
landing/src/pages/blog/*

# Vale's own fixtures, which carry hits on purpose.
.vale/*

# Agent rules and skills, which quote the patterns they forbid.
.claude/*

# Generated by git-cliff from commit messages.
CHANGELOG.md
*/CHANGELOG.md

# Verbatim third-party text.
vendor/*
CODE_OF_CONDUCT.md
landing/src/pages/legal/*

# Test data and issue templates, not prose.
*/testdata/*
.github/ISSUE_TEMPLATE/*
.github/PULL_REQUEST_TEMPLATE.md
