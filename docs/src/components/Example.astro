---
interface Props {
  label?: string;
}

const { label = 'Example' } = Astro.props;
---

<aside class="example">
  {label && <p class="example-label">{label}</p>}
  <div class="example-body"><slot /></div>
</aside>

<style>
  .example {
    /* Bottom margin also sets the gap between stacked example callouts, which
       collapses against the next one's top margin. */
    margin: 1.25rem 0 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.5rem;
    background-color: var(--sl-color-gray-6);
  }

  .example-label {
    margin: 0 0 0.625rem !important;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-3);
  }

  /* Slotted MDX paragraphs: tighter than body copy so the block reads as one
     unit rather than as ordinary prose that happens to be indented. */
  /* Same Starlight sibling-margin rule applies here: zero it so the label's own
     margin sets the gap. */
  .example-body {
    margin-top: 0;
  }

  .example-body :global(p) {
    margin-bottom: 0.75rem !important;
    line-height: 1.6 !important;
  }

  .example-body :global(p:last-child) {
    margin-bottom: 0 !important;
  }

  /* Two paragraphs in a row read as a break in the scenario, so give them a
     wider gap than the paragraphs that sit either side of a prompt. */
  .example-body :global(p + p) {
    margin-top: 1.25rem !important;
  }

  /* Nested prompts: outlined but unfilled, so they read as a distinct object
     against the callout's fill without stacking two filled boxes. The accent
     bar on the leading edge marks them as the user's words. */
  .example-body :global(.prompt) {
    margin-block: 1.375rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.375rem;
    background: none;
  }

</style>
