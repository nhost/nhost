---
interface Props {
  label?: string;
  /** Text to put on the clipboard. Omit to render the prompt without a button. */
  copy?: string;
}

const { label = 'Prompt', copy } = Astro.props;
---

<figure class="prompt">
  <figcaption class="prompt-label">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M8.625 9.75a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.068.157 2.148.279 3.238.364.466.037.893.281 1.153.671L12 21l2.755-4.133a1.55 1.55 0 0 1 1.153-.67 48.4 48.4 0 0 0 3.238-.365c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.4 48.4 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"
      ></path>
    </svg>
    {label}
    {
      copy && (
        <button class="prompt-copy" type="button" data-prompt-copy={copy} aria-label="Copy prompt">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span class="prompt-copy-label">Copy</span>
        </button>
      )
    }
  </figcaption>
  <div class="prompt-body"><slot /></div>
</figure>

<style>
  .prompt {
    /* Hug the prompt text instead of filling the column, so a short prompt reads
       as a quoted utterance rather than a full-width panel. Long prompts still
       wrap at the container's edge. */
    /* Full width, matching the other callouts on the page. */
    margin: 1rem 0 1.5rem;
    /* Extra inline-start padding sets the content in from the accent bar. */
    padding: 1rem 1.25rem 1rem 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    /* Accent bar as an inset shadow, not a thicker border: mismatched border
       widths get mitred across the radius and render as a tapered wedge. */
    box-shadow: inset 3px 0 0 0 var(--sl-color-accent);
    background-color: var(--sl-color-gray-6);
  }

  .prompt-label {
    display: flex;
    align-items: center;
    /* No flex gap: the icon owns its own trailing margin so the copy button can
       be pushed to the far edge without inheriting the label's spacing. */
    gap: 0;
    /* The perceived gap is mostly the label's leading, so flatten line-height
       rather than leaning on margin alone. */
    margin-bottom: 0;
    line-height: 1;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-text-accent);
  }

  .prompt-label > svg {
    width: 0.875rem;
    height: 0.875rem;
    margin-inline-end: 0.375rem;
  }

  .prompt-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    margin-inline-start: auto;
    padding: 0.1875rem 0.4375rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.3125rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 0.15s, color 0.15s, border-color 0.15s;
  }

  .prompt-copy:hover,
  .prompt-copy:focus-visible {
    opacity: 1;
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }

  .prompt-copy:focus-visible {
    outline: 2px solid var(--sl-color-gray-3);
    outline-offset: 1px;
  }

  .prompt-copy svg {
    width: 0.8125rem;
    height: 0.8125rem;
  }

  .prompt-copy.copied {
    opacity: 1;
    color: #3fb950;
    border-color: #3fb950;
  }

  :global([data-theme='light']) .prompt-copy.copied {
    color: #1a7f37;
    border-color: #1a7f37;
  }

  .prompt-body {
    /* Starlight gives any element following a sibling `--sl-content-gap-y` of
       top margin, which would open a 1rem gap under the label. Zero it and set
       the gap here instead. */
    margin-top: 0.25rem;
    color: var(--sl-color-white);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.6;
  }

  /* Slotted MDX content renders as paragraphs; keep them flush inside the box. */
  .prompt-body :global(p) {
    margin: 0 !important;
  }

  .prompt-body :global(p + p) {
    margin-top: 0.5rem !important;
  }
</style>

<script>
  let controller: AbortController;
  const timers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();

  function initPromptCopy() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    document.querySelectorAll<HTMLButtonElement>('.prompt-copy').forEach((btn) => {
      const label = btn.querySelector<HTMLElement>('.prompt-copy-label');
      btn.addEventListener(
        'click',
        () => {
          navigator.clipboard
            .writeText(btn.dataset.promptCopy || '')
            .then(() => {
              clearTimeout(timers.get(btn));
              btn.classList.add('copied');
              if (label) label.textContent = 'Copied!';
              timers.set(
                btn,
                setTimeout(() => {
                  btn.classList.remove('copied');
                  if (label) label.textContent = 'Copy';
                }, 2000),
              );
            })
            .catch(() => {});
        },
        { signal },
      );
    });
  }

  initPromptCopy();
  document.addEventListener('astro:after-swap', initPromptCopy);
</script>
