---
/**
 * Page Feedback component for documentation articles.
 * Allows readers to vote if a page was helpful and emits `docs.page.feedback`.
 */
---

<aside class="page-feedback not-content" aria-label="Page feedback">
  <div class="feedback-prompt" data-feedback-prompt>
    <span class="feedback-question">Was this page helpful?</span>
    <div class="feedback-actions">
      <button
        type="button"
        class="feedback-btn feedback-yes"
        data-feedback="yes"
        aria-label="Yes, this page was helpful"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 10v12"></path>
          <path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.5L12 3a2 2 0 0 1 3 2.88Z"></path>
        </svg>
        <span>Yes</span>
      </button>

      <button
        type="button"
        class="feedback-btn feedback-no"
        data-feedback="no"
        aria-label="No, this page was not helpful"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M17 14V2"></path>
          <path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.5L12 21a2 2 0 0 1-3-2.88Z"></path>
        </svg>
        <span>No</span>
      </button>
    </div>
  </div>

  <div class="feedback-response" data-feedback-response hidden aria-live="polite">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="feedback-check-icon"
      aria-hidden="true"
    >
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span>Thanks for your feedback!</span>
  </div>
</aside>

<script>
  import { trackPageFeedback } from '../lib/analytics';

  function initPageFeedback() {
    const widgets = document.querySelectorAll<HTMLElement>('.page-feedback');

    widgets.forEach((widget) => {
      const prompt = widget.querySelector<HTMLElement>('[data-feedback-prompt]');
      const response = widget.querySelector<HTMLElement>('[data-feedback-response]');
      if (!prompt || !response) return;

      const storageKey = `nhost_docs_feedback_${window.location.pathname}`;

      // Check if already submitted in this session
      try {
        if (sessionStorage.getItem(storageKey)) {
          prompt.hidden = true;
          response.hidden = false;
          return;
        }
      } catch {
        // Ignore storage errors (private browsing, etc.)
      }

      const buttons = widget.querySelectorAll<HTMLButtonElement>('[data-feedback]');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const isHelpful = btn.dataset.feedback === 'yes';

          trackPageFeedback(isHelpful, window.location.pathname, document.title);

          try {
            sessionStorage.setItem(storageKey, isHelpful ? 'yes' : 'no');
          } catch {
            // Ignore storage errors
          }

          prompt.hidden = true;
          response.hidden = false;
        });
      });
    });
  }

  // Initialize on load and on Astro view transition navigations
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPageFeedback);
  } else {
    initPageFeedback();
  }

  document.addEventListener('astro:page-load', initPageFeedback);
  document.addEventListener('astro:after-swap', initPageFeedback);
</script>

<style>
  .page-feedback {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: var(--sl-color-bg-inline-code);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .feedback-prompt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .feedback-question {
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-white);
  }

  .feedback-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .feedback-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.375rem;
    background-color: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
  }

  .feedback-btn:hover {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
  }

  .feedback-btn:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .feedback-response {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-green, #10b981);
  }

  .feedback-check-icon {
    color: var(--sl-color-green, #10b981);
  }
</style>
